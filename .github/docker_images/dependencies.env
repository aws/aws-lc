# Single source of truth for externally-hosted dependencies that are pinned by
# version and baked into the CI docker images. Consumers load this file and
# pass the values through as docker --build-arg; the Dockerfiles declare the
# matching ARGs with no defaults so a stale or missing pin fails fast instead
# of building against drifted values.
#
# Format: KEY=VALUE only. Consumers append these lines to $GITHUB_ENV or
# source them from shell, so keep values free of spaces and quoting.
#
# Intel SDE (Software Development Emulator).
# Intel assigns each release an opaque download id (the path component of
# SDE_MIRROR_URL_BASE) and has deleted old releases from the mirror before
# (9.44.0 started returning AccessDenied in 2026), so expect version bumps to
# be forced occasionally. To bump: find the new id and version tag at
# https://www.intel.com/content/www/us/en/download/684897/ (in a browser; the
# page is bot-walled), then update the checksums from the new tarballs.
SDE_VERSION_TAG_LIN=sde-external-9.58.0-2025-06-16-lin
SDE_VERSION_TAG_WIN=sde-external-9.58.0-2025-06-16-win
SDE_MIRROR_URL_LIN=https://downloadmirror.intel.com/859732/sde-external-9.58.0-2025-06-16-lin.tar.xz
SDE_MIRROR_URL_WIN=https://downloadmirror.intel.com/859732/sde-external-9.58.0-2025-06-16-win.tar.xz
SDE_SHA256_LIN=f849acecad4c9b108259c643b2688fd65c35723cd23368abe5dd64b917cc18c0
SDE_SHA256_WIN=ebb8b3b63fcb0b6c1f9721118ba4883703d2aed9e0db2defed4e44fba78d9ca9
# Version prefix the container-validation steps expect "sde --version" to report.
SDE_VERSION_PREFIX=9.58

# Standalone Rust toolchain for the Ubuntu 10.04 image. Pinned permanently to
# 1.63.0, the last release that runs on glibc older than 2.17 (see
# setup-rust-standalone.sh); this only changes if that image is retired.
# Checksum is from the companion file at
# https://static.rust-lang.org/dist/rust-1.63.0-x86_64-unknown-linux-gnu.tar.gz.sha256
RUST_STANDALONE_TARBALL=rust-1.63.0-x86_64-unknown-linux-gnu.tar.gz
RUST_STANDALONE_URL=https://static.rust-lang.org/dist/rust-1.63.0-x86_64-unknown-linux-gnu.tar.gz
RUST_STANDALONE_SHA256=536bcf16807a4ff49b7b29af6e573a2f1821055bfad72c275c60e56edc693984
RUST_STANDALONE_VERSION_PREFIX=1.63
