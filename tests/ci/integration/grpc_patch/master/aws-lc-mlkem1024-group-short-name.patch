diff --git a/test/core/tsi/ssl_transport_security_test.cc b/test/core/tsi/ssl_transport_security_test.cc
index 0f60b157..932d4b1b 100644
--- a/test/core/tsi/ssl_transport_security_test.cc
+++ b/test/core/tsi/ssl_transport_security_test.cc
@@ -1800,7 +1800,14 @@ TEST_P(SslTransportSecurityTest, SuccessfulHandshakeMlkem1024) {
   if (tls_version == TSI_TLS1_3) {
     ssl_fixture_->OverrideClientKeyExchangeGroups({GRPC_TLS_GROUP_MLKEM1024});
     ssl_fixture_->OverrideServerKeyExchangeGroups({GRPC_TLS_GROUP_MLKEM1024});
+    // The negotiated group is reported via OBJ_nid2sn, so the expected string
+    // is the library's short name for the ML-KEM-1024 OID. BoringSSL and
+    // OpenSSL 3.5 spell it "id-alg-ml-kem-1024"; AWS-LC spells it "MLKEM1024".
+#ifdef OPENSSL_IS_AWSLC
+    ssl_fixture_->SetExpectedNegotiatedGroup("MLKEM1024");
+#else
     ssl_fixture_->SetExpectedNegotiatedGroup("id-alg-ml-kem-1024");
+#endif
   }
   DoHandshake();
 }
