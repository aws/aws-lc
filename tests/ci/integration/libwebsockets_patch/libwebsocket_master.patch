 		switch (mode) {
@@ -222,7 +236,7 @@ lws_genaes_create(struct lws_genaes_ctx *ctx, enum enum_aes_operation op,
 
 	case 512 / 8:
 		switch (mode) {
-#if defined(LWS_HAVE_EVP_aes_128_xts) && !defined(LWS_WITH_BORINGSSL) && !defined(LWS_WITH_BORINGSSL)
+#if defined(LWS_HAVE_EVP_aes_256_xts) && !defined(LWS_WITH_BORINGSSL)
 		case LWS_GAESM_XTS:
 			ctx->cipher = EVP_aes_256_xts();
 #endif
@@ -337,6 +351,28 @@ lws_genaes_crypt(struct lws_genaes_ctx *ctx,
 {
 	int n = 0, outl, olen;
 
+#if defined(LWS_WITH_AWSLC)
+	if (ctx->mode == LWS_GAESM_KW) {
+		AES_KEY key;
+		int ret = -1;
+
+		if (!in || !out)
+			return -1;
+
+		if (ctx->op == LWS_GAESO_ENC) {
+			if (!AES_set_encrypt_key(ctx->k->buf, ctx->k->len * 8, &key))
+				ret = AES_wrap_key(&key,
+					iv_or_nonce_ctr_or_data_unit_16, out, in, len);
+		} else if (ctx->op == LWS_GAESO_DEC) {
+			if (!AES_set_decrypt_key(ctx->k->buf, ctx->k->len * 8, &key))
+				ret = AES_unwrap_key(&key,
+					iv_or_nonce_ctr_or_data_unit_16, out, in, len);
+		}
+		lws_explicit_bzero(&key, sizeof(key));
+		return ret < 0 ? -1 : 0;
+	}
+#endif
+
 	if (!ctx->init) {
 
 		EVP_CIPHER_CTX_set_key_length(ctx->ctx, SSL_UINT_CAST(ctx->k->len));
