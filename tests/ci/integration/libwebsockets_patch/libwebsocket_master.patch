@@ -55,6 +58,17 @@ lws_genaes_create(struct lws_genaes_ctx *ctx, enum enum_aes_operation op,
 	/* the ctx is caller storage that may be uninitialized */
 	ctx->cipher = NULL;
 
+#if defined(LWS_WITH_AWSLC)
+	/* AWS-LC exposes only AES-256-KW through EVP. */
+	if (mode == LWS_GAESM_KW) {
+		if (!el || !el->buf ||
+		    (el->len != 16 && el->len != 24 && el->len != 32) ||
+		    (op != LWS_GAESO_ENC && op != LWS_GAESO_DEC))
+			goto bail;
+		return 0;
+	}
+#endif
+
 	switch (ctx->k->len) {
